# ========================================
# MindWeave - Environment Variables Template
# ========================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# ------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------
# Local Docker: docker compose up -d
DATABASE_URL="postgresql://mindweave:mindweave_local@localhost:5433/mindweave"
DIRECT_URL="postgresql://mindweave:mindweave_local@localhost:5433/mindweave"
# Production (Neon): replace with your Neon connection strings

# ------------------------------------------
# Authentication (NextAuth.js v5)
# ------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""                    # Run: openssl rand -base64 32

# ------------------------------------------
# AI Provider (Google Gemini)
# ------------------------------------------
GEMINI_API_KEY=""                     # Get from https://aistudio.google.com/apikey

# ------------------------------------------
# Payments (Stripe)
# ------------------------------------------
STRIPE_SECRET_KEY=""                  # From Stripe Dashboard
STRIPE_WEBHOOK_SECRET=""              # From Stripe CLI or Dashboard
STRIPE_PRICE_MONTHLY=""               # Stripe Price ID for monthly plan
STRIPE_PRICE_ANNUAL=""                # Stripe Price ID for annual plan
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="" # Publishable key (safe for client)

# ------------------------------------------
# Email (Resend)
# ------------------------------------------
RESEND_API_KEY=""                     # From https://resend.com
EMAIL_FROM="noreply@mindweave.app"

# ------------------------------------------
# Redis — Local Docker (port 6380) or Vercel KV in production
# ------------------------------------------
KV_URL="redis://localhost:6380"
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
KV_REST_API_READ_ONLY_TOKEN=""

# ------------------------------------------
# Vercel Blob - for exports
# ------------------------------------------
BLOB_READ_WRITE_TOKEN=""

# ------------------------------------------
# Cron Jobs
# ------------------------------------------
CRON_SECRET=""                        # Run: openssl rand -base64 32

# ------------------------------------------
# App
# ------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
